{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "world.bymattking.com"
        }
      ],
      "dest": "/world/index.html"
    },
    {
      "src": "/(penthouse|jet|miami|monaco)/?",
      "has": [
        {
          "type": "host",
          "value": "world.bymattking.com"
        }
      ],
      "dest": "/world/index.html"
    },
    {
      "src": "/thinking/(the-clipping-economy|ai-is-the-pit-crew)/?",
      "status": 301,
      "headers": { "Location": "/writing/$1/" }
    },
    {
      "handle": "filesystem"
    }
  ]
}
