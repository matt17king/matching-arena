{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/world(?:/(?:index\\.html)?)?",
      "has": [
        {
          "type": "host",
          "value": "www.bymattking.com"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://world.bymattking.com/"
      }
    },
    {
      "src": "/world(?:/(?:index\\.html)?)?",
      "has": [
        {
          "type": "host",
          "value": "bymattking.com"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://world.bymattking.com/"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "world.bymattking.com"
        }
      ],
      "dest": "/world/index.html"
    },
    {
      "src": "/(penthouse|jet|miami|monaco)/?",
      "has": [
        {
          "type": "host",
          "value": "world.bymattking.com"
        }
      ],
      "dest": "/world/index.html"
    },
    {
      "src": "/plays/(drive-to-survive|taylor-swift-chiefs|alcaraz-travis-scott-nike|baller-league)/?",
      "status": 301,
      "headers": {
        "Location": "/writing/$1/"
      }
    },
    {
      "src": "/plays/?",
      "status": 301,
      "headers": {
        "Location": "/writing/"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}
